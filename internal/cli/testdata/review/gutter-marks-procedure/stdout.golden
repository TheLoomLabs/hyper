  PROCEDURE                 │  procedures/subject.yaml                 no baseline — no Store
  ──────────────────────────┼────────────────────────────────────────────────────────────────
                            │ # Every mark the gutter carries on a Procedure, on one screen.
                            │ kind: procedure
                            │ procedure: subject
  envelope ✓                │ targets: [local, staging]
                            │ steps:
  read             staging  │   - id: enumerate  # a read, and the Target it binds
                            │     definition: things-observed
                            │     operation: list_things
                            │     target: staging
                            │     args:
                            │       page_size: "100"
                            │
  mutate!          staging  │   - id: make
                            │     definition: things
                            │     operation: make_thing
                            │     target: staging
                            │     args:
                            │       name: preview-42
                            │
  mutate           staging  │   - id: make-bounded
                            │     definition: things
                            │     operation: make_thing
                            │     target: staging
                            │     over:
                            │       values:
                            │         - preview-43
                            │         - preview-44
                            │     args:
                            │       name: {item: $}
                            │     bound: 4
                            │
  DESTROY          staging  │   - id: retire
                            │     definition: things
                            │     operation: end_thing
                            │     target: staging
                            │     over:
                            │       assets:
                            │         - field: name
                            │           starts_with: preview-
                            │     args:
                            │       thing_id: {item: $.id}
                            │     bound: 5
                            │
  DESTROY  opaque  local    │   - id: scrub
                            │     definition: commands-destroy
                            │     operation: destroy
                            │     target: local
                            │     over:
                            │       assets:
                            │         - field: stdout
                            │           starts_with: preview-
                            │     args:
                            │       command: [rm, -rf, /srv/preview]
                            │
  unresolved                │   - id: no-such-definition
                            │     definition: not-there
                            │     operation: list_things
                            │     target: staging
                            │
  unresolved                │   - id: no-such-operation
                            │     definition: things
                            │     operation: not_there
                            │     target: staging
                            │
  unresolved                │   - id: no-such-provider
                            │     definition: orphan
                            │     operation: list_things
                            │     target: staging
                            │
                   staging  │   - id: nested
                            │     procedure: inner
                            │
  unresolved                │   - id: no-such-procedure
                            │     procedure: not-there
